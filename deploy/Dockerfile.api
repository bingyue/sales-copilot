FROM eclipse-temurin:21-jre
WORKDIR /app
RUN groupadd --system sales && useradd --system --gid sales sales && mkdir -p /data/upload && chown -R sales:sales /data
COPY target/sales-copilot-1.0.0.jar /app/app.jar
USER sales
EXPOSE 8085
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=65", "-Djava.net.useSystemProxies=false", "-Djava.net.preferIPv4Stack=true", "-jar", "/app/app.jar"]
